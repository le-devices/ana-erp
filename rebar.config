{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {epgsql, "4.7.1"},
    {cowboy, "2.12.0"}
]}.

{relx, [
    {release, {ana, "0.1.0"}, [ana, sasl]},
    {mode, prod},
    {include_erts, true},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {test, [{erl_opts, [nowarn_export_all]}]}
]}.

{shell, [{apps, [ana]}]}.

{dialyzer, [{plt_extra_apps, [ranch]}, {warnings, [unmatched_returns, error_handling]}]}.
